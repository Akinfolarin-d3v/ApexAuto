rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// Or paste directly into Firebase Console → Firestore Database → Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Real Firebase Auth email/password account — created manually in
    // the Firebase Console. Can invite/revoke other admins.
    function isPrimaryAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Signed in via the invite flow (anonymous auth bound to an
    // allowlisted email — see lib/auth.js). Can manage inventory but
    // cannot invite further admins.
    function isInvitedAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isPrimaryAdmin() || isInvitedAdmin();
    }

    match /cars/{carId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Anyone can fetch ONE order by its (unguessable) id — that's how
      // the checkout confirmation page works with no customer account.
      // Only admins can list/query the whole collection.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /contactSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /tradeInSubmissions/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Invite allowlist, keyed by lowercased email. Only the primary
    // admin can create/delete entries. The invited person reads their
    // own invite during login, then stamps their new anonymous uid onto
    // it (and only that one field, in one write) to claim it.
    match /admin_invites/{email} {
      allow read: if request.auth != null;
      allow create, delete: if isPrimaryAdmin();
      allow update: if request.auth != null
        && resource.data.claimedUid == null
        && request.resource.data.claimedUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUid']);
    }

    // Claimed admin identities, keyed by uid so isInvitedAdmin() above
    // can look them up directly. Self-created once, only if a matching
    // invite exists for the email being claimed.
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.email is string
        && exists(/databases/$(database)/documents/admin_invites/$(request.resource.data.email));
      allow delete: if isPrimaryAdmin();
    }
  }
}
